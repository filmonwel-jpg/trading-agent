# Databento + IBKR bridge settings
DATABENTO_API_KEY=replace_me
DATABENTO_USER_ID=replace_me
DATABENTO_DATASET=DBEQ.BASIC
DATABENTO_SCHEMA=tbbo
DATABENTO_STYPE_IN=raw_symbol
SYMBOLS_FILE=config/symbols_100.txt

# Bridge runtime mode: scaffold | consume_backfill | shared_ibkr_gateway | shared_ibkr_gateway_server
BRIDGE_MODE=scaffold
BACKFILL_RUN_ID=
MAX_ORDERS_PER_CYCLE=20
MIN_IMBALANCE_RATIO=0.35
MAX_QUOTE_AGE_MINUTES=30

# Optional DB overrides for backfill consumer mode
# HARVEST_DB_URL=postgresql://localhost:5432/trading_agent
# HARVEST_DB_USER=
# HARVEST_DB_PASSWORD=

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID_BASE=210
SHARED_IBKR_GATEWAY_HOST=127.0.0.1
SHARED_IBKR_GATEWAY_PORT=9910
# Keep live order submission off the slow qualifyContracts hot path by default.
# Set true only if your IBKR environment requires pre-qualified contracts before placeOrder.
SHARED_IBKR_GATEWAY_REQUIRE_QUALIFIED_CONTRACTS=false
# Increase if strict qualification is enabled or IBKR is slow to respond.
SHARED_IBKR_GATEWAY_IB_CALL_TIMEOUT_SECONDS=10

# Safety defaults
DRY_RUN=true
MAX_SYMBOLS=100
ORDER_NOTIONAL_USD=10000

# Isolated output paths (relative to repo root)
OUTPUT_ROOT=runtime/databento/output
LOG_ROOT=runtime/databento/logs
STATE_ROOT=runtime/databento/state

