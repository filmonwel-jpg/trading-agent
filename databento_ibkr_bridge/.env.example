# Databento + IBKR bridge settings
DATABENTO_API_KEY=replace_me
DATABENTO_DATASET=GLBX.MDP3
DATABENTO_SCHEMA=mbp-1
SYMBOLS_FILE=config/symbols_100.txt

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID_BASE=210

# Safety defaults
DRY_RUN=true
MAX_SYMBOLS=100
ORDER_NOTIONAL_USD=10000

# Isolated output paths (relative to repo root)
OUTPUT_ROOT=runtime/databento/output
LOG_ROOT=runtime/databento/logs
STATE_ROOT=runtime/databento/state

