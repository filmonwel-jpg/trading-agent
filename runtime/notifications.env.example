# Copy to runtime/notifications.env to enable phone confirmations.
# The notification helper always writes local files even if remote delivery is disabled.

STACK_NOTIFY_ENABLED=1
STACK_NOTIFY_TIMEOUT_SECONDS=5

# Optional hostname label shown in messages.
# STACK_NOTIFY_HOSTNAME="filmon-trading-mac"

# Option A: generic webhook on your local network.
# Example: Home Assistant webhook, local Node-RED flow, local automation server, etc.
# STACK_NOTIFY_WEBHOOK_URL="http://192.168.1.50:8123/api/webhook/trading-agent"

# Option B: ntfy topic URL. This is the simplest phone setup if you want push notifications
# on local Wi-Fi: run an ntfy server on your Mac / LAN, install the ntfy app on your phone,
# and subscribe to the same topic.
# STACK_NOTIFY_NTFY_URL="http://192.168.1.20:8080/trading-agent"

# Notes:
# - If neither URL is configured, notifications are still logged locally to:
#   runtime/stack-notifications.log
#   runtime/stack-last-status.json
# - Keep local-only URLs in this file; do not commit private network addresses if you do not want them in git.
