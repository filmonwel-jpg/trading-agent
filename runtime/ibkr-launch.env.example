# Copy this file to runtime/ibkr-launch.env and adjust as needed.
# The morning launcher will auto-source runtime/ibkr-launch.env if present.

# Optional explicit API endpoint overrides.
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497

# How long the morning preflight should wait for TWS / Gateway to expose the API.
IBKR_WAIT_SECONDS=180
IBKR_POLL_SECONDS=5

# Leave auto-launch enabled unless you want a pure status check.
IBKR_AUTO_LAUNCH=1

# Option A: point directly at the app bundle.
# IBKR_APP_PATH="/Applications/Trader Workstation.app"

# Option B: specify the macOS application name.
# IBKR_APP_NAME="Trader Workstation"
# IBKR_APP_NAME="IB Gateway"

# Option C: preferred for unattended login if you later install a secure external launcher.
# This can be an IBC wrapper, a local script that pulls credentials from Keychain,
# or any command that starts TWS / Gateway.
# IBKR_LAUNCH_CMD='open -a "Trader Workstation"'
# IBKR_LAUNCH_CMD='/Users/filmonghezehey/trading-agent/ibkr_keychain_launch.sh'

# Optional custom shutdown command. If unset, the helper will try a normal macOS app quit.
# IBKR_SHUTDOWN_CMD='osascript -e "tell application \"Trader Workstation\" to quit"'

# If IBKR ignores the graceful quit and you want the helper to force-stop it after timeout,
# enable this fallback.
# IBKR_FORCE_KILL_ON_SHUTDOWN=1

# Notes:
# - Do not commit real usernames/passwords into repo files.
# - Native IBKR login often still requires 2FA/device trust, so fully unattended login
#   usually needs an external tool such as IBC plus your own secure secret handling.

