# Copy this file to runtime/ibkr-keychain.env.
# This file should remain local-only; do not commit it.

# Which Keychain account/service names to use.
IBKR_KEYCHAIN_ACCOUNT="$USER"
IBKR_KEYCHAIN_USERNAME_SERVICE="trading-agent.ibkr.username"
IBKR_KEYCHAIN_PASSWORD_SERVICE="trading-agent.ibkr.password"

# Which app to launch.
IBKR_KEYCHAIN_APP_NAME="Trader Workstation"
# IBKR_KEYCHAIN_APP_PATH="/Users/filmonghezehey/Applications/Trader Workstation/Trader Workstation.app"

# Timing and UI-scripting behavior.
IBKR_KEYCHAIN_LAUNCH_DELAY_SECONDS=8
IBKR_KEYCHAIN_AUTOFILL=1

# If the login cursor is not already in the username field, tab forward first.
IBKR_KEYCHAIN_TAB_TO_USERNAME_COUNT=0

# Number of Tab presses between typing the username and typing the password.
IBKR_KEYCHAIN_TAB_BETWEEN_FIELDS=1

# Number of extra Tab presses after typing the password before submit.
IBKR_KEYCHAIN_TAB_TO_SUBMIT_COUNT=0

# Submit mode after typing the password. Common values: return or none.
IBKR_KEYCHAIN_SUBMIT_MODE="return"

# Notes:
# - macOS Accessibility permissions are required for UI scripting.
# - IBKR 2FA / trusted-device prompts may still require manual approval.
# - If the IBKR login screen layout changes, adjust the tab counts above.

